countdownText.Text = "Black screen disappears in 10s | الشاشة السوداء تختفي بعد 10 ثواني"

local function startCountdown()
    for i = 10, 1, -1 do
        countdownText.Text = "Black screen disappears in " .. tostring(i) .. "s | الشاشة السوداء تختفي بعد " .. tostring(i) .. " ثواني"
        wait(1)
    end
    screenGui:Destroy()
end

startCountdown()
